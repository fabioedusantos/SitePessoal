APP_ENV=development
APP_DEBUG=true
TRUST_PROXY_HEADERS=false

# MariaDB / conexão da API
MARIADB_DATABASE=fbsantos
MARIADB_USER=fbsantos
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-root-me
DB_HOST=db
DB_PORT=3306

# Acesso administrativo
ADMIN_EMAIL=admin@example.test
ADMIN_DISPLAY_NAME=Administrador
# Gere com: php bin/hash-admin-password.php
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters
JWT_ISSUER=fbsantos-api
JWT_AUDIENCE=fbsantos-panel
JWT_TTL_SECONDS=14400
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_BLOCK_MINUTES=30

# Formulário público / hCaptcha (chaves oficiais de teste em DEV)
HCAPTCHA_ENABLED=true
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_BLOCK_SECONDS=1800

# SMTP. Em DEV pode ficar false para testar o fluxo sem enviar e-mails.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-to-app-password
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=FBSantos
CONTACT_TO_EMAIL=you@example.com
CONTACT_AUTO_REPLY=true
MAIL_DAILY_LIMIT=450
MAIL_QUOTA_TIMEZONE=America/Sao_Paulo

UPLOADS_PATH=/var/www/html/public/uploads
UPLOAD_MAX_IMAGE_MB=12
UPLOAD_WEBP_QUALITY=88

GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
GA_SERVICE_ACCOUNT_PRIVATE_KEY_B64=
GA_CACHE_SECONDS=300
