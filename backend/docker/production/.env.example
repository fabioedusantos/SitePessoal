APP_ENV=production
APP_DEBUG=false
TRUST_PROXY_HEADERS=true
API_ALLOWED_HOSTS=fbsantos-api,fbsantos.com.br,www.fbsantos.com.br,painel.fbsantos.com.br

# MariaDB / conexão da API
MARIADB_DATABASE=fbsantos
MARIADB_USER=fbsantos
MARIADB_PASSWORD=replace-with-a-strong-random-password
MARIADB_ROOT_PASSWORD=replace-with-another-strong-random-password
DB_HOST=backend-db
DB_PORT=3306

# Acesso administrativo (senha somente como hash bcrypt; nunca em texto puro)
ADMIN_EMAIL=you@example.com
ADMIN_DISPLAY_NAME=Administrador
# Gere dentro da pasta docker com: docker compose exec app php bin/hash-admin-password.php
ADMIN_PASSWORD_HASH=

# Sessão administrativa
# Gere uma string aleatória longa (mínimo 48 caracteres).
JWT_SECRET=replace-with-at-least-48-random-characters
JWT_ISSUER=fbsantos-api
JWT_AUDIENCE=fbsantos-panel
JWT_TTL_SECONDS=14400
CORS_ALLOWED_ORIGINS=https://fbsantos.com.br,https://www.fbsantos.com.br,https://painel.fbsantos.com.br
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_BLOCK_MINUTES=30

# Formulário público / hCaptcha
HCAPTCHA_ENABLED=true
HCAPTCHA_SITEKEY=replace-with-hcaptcha-sitekey
HCAPTCHA_SECRET=replace-with-hcaptcha-secret
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=900
CONTACT_RATE_LIMIT_BLOCK_SECONDS=1800

# SMTP. Use senha de app, nunca a senha principal da conta.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=replace-with-app-password
MAIL_FROM_EMAIL=you@example.com
MAIL_FROM_NAME=FBSantos
CONTACT_TO_EMAIL=you@example.com
CONTACT_AUTO_REPLY=true
# Limite conservador, aplicado por dia local e nas últimas 24 horas. Máximo permitido: 450.
MAIL_DAILY_LIMIT=450
MAIL_QUOTA_TIMEZONE=America/Sao_Paulo

# Uploads administrados pelo CMS. URLs novas são armazenadas como /uploads/...
UPLOADS_PATH=/var/www/html/public/uploads
UPLOAD_MAX_IMAGE_MB=12
UPLOAD_WEBP_QUALITY=88

# Google Analytics Data API (opcional para o painel).
# Dê à conta de serviço acesso de leitura à propriedade GA4.
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_EMAIL=
# Base64 do conteúdo completo da chave privada PEM, sem quebras de linha no .env.
GA_SERVICE_ACCOUNT_PRIVATE_KEY_B64=
GA_CACHE_SECONDS=300